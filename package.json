{
  "name": "tool-call-validator",
  "version": "0.1.0",
  "description": "Parse and validate LLM tool-call JSON payloads. Loose JSON parsing (repairs common LLM mistakes) + JSON-Schema-subset validation. Zero dependencies.",
  "keywords": ["llm", "tool-call", "function-calling", "json-schema", "json", "repair"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": { "node": ">=20" },
  "author": { "name": "Vlad Bordei", "email": "bordeivlad@gmail.com", "url": "https://github.com/p-vbordei" },
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/p-vbordei/tool-call-validator.git" },
  "bugs": { "url": "https://github.com/p-vbordei/tool-call-validator/issues" },
  "homepage": "https://github.com/p-vbordei/tool-call-validator#readme",
  "devDependencies": { "typescript": "^5.5.0", "vitest": "^4.1.6" }
}
