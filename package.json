{
  "name": "tool-call-validator",
  "version": "0.1.0",
  "description": "Validate an LLM tool/function call's JSON arguments against the tool's declared JSON-Schema-subset; throws on malformed schema or input",
  "cube": { "family": "lib" },
  "type": "module",
  "license": "Apache-2.0",
  "author": "Vlad Bordei <vlad@vollko.com>",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "llm",
    "tool-call",
    "function-calling",
    "json-schema",
    "validation"
  ],
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
